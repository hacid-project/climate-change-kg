# Installed as .env in the knowledge-graph-serve checkout (install.sh kgserve), where Docker
# Compose reads it: plain "docker compose ..." commands there then use these settings.

# A name of its own, distinct from the project "climate-change-kg" of climate-change-kg-docker.
COMPOSE_PROJECT_NAME=kgserve-climate-change-kg
# GraphDB as the store (the inference regime rdfsplus-optimized is a GraphDB ruleset), and the
# settings of keng.istc.cnr.it.
COMPOSE_FILE=compose.yaml:compose.graphdb.yaml:compose.keng.yaml
# Where the service answers, for the front nginx only. 8081, as 8080 was taken by the LodView
# of climate-change-kg-docker.
KG_LISTEN=127.0.0.1:8081
