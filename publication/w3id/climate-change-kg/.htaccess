# Climate Change Knowledge Graph (CCKG)
# https://w3id.org/climate-change-kg
#
# DRAFT: replace SPARQL_ENDPOINT_URL and LINKED_DATA_BASE_URL with the targets
# currently used by the rules of /hacid/cs/sparql and /hacid/data/cs/ (see
# README.md in publication/w3id of the workflow repository).

Options +FollowSymLinks
RewriteEngine on

# SPARQL endpoint (the query string is passed on)
RewriteRule ^sparql/?$ SPARQL_ENDPOINT_URL [R=302,NE,L]

# Resources and named graphs of the knowledge graph
RewriteRule ^data$ LINKED_DATA_BASE_URL/climate-change-kg/data [R=303,NE,L]
RewriteRule ^data/(.*)$ LINKED_DATA_BASE_URL/climate-change-kg/data/$1 [R=303,NE,L]

# Website (documentation)
RewriteRule ^$ https://hacid-project.github.io/cckg/ [R=302,L]
RewriteRule ^(.+)$ https://hacid-project.github.io/cckg/$1 [R=302,NE,L]
