# To be added to hacid/.htaccess of perma-id/w3id.org, BEFORE the existing
# rules for data/ and cs/sparql: the climate services KG of HACID is now the
# Climate Change Knowledge Graph, in its own namespace.

RewriteRule ^cs/sparql/?$ https://w3id.org/cckg/sparql [R=301,NE,L]
RewriteRule ^data/cs$ https://w3id.org/cckg/data [R=301,NE,L]
RewriteRule ^data/cs/(.*)$ https://w3id.org/cckg/data/$1 [R=301,NE,L]
