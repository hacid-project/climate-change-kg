# Workflow of the Climate Change Knowledge Graph (see the README).
#
# Run from the repository root. The main targets:
#   snakemake --cores 4                         # build (default): the whole KG, validated, with its metadata
#   snakemake --cores 4 release --config version=X.Y.Z    # a release (rules/release.smk)
#   snakemake --cores 4 release_preview --config version=X.Y.Z  # a release up to the draft on Zenodo
#   snakemake --cores 4 sources_analysis        # the analyses of the sources (not in the KG)
#
# Parts of the build:
#   snakemake --cores 4 mapping                 # all the mappings to the KG
#   snakemake --cores 4 consolidate             # the KG loaded, consolidated, described and exported (kg/)
#   snakemake --cores 4 validate                # the consolidated KG validated with its SHACL shapes (shapes/)
#   snakemake --cores 4 metadata                # the metadata of the KG (VoID, DCAT, PROV), loaded in it
#   snakemake --cores 4 <source>                # the mapping of one source: ontologies, gwls,
#                                               # cf_standard_names, cmor_tables, cmip5_cvs, cmip5,
#                                               # cordex_domains, cordex_cmip5_cvs, cordex_cmip5, ukcp18,
#                                               # climdex, mohc_cvs
#   snakemake --cores 4 cmor_tables_analysis    # analysis of all the CMOR tables editions

import csv
import glob
import json
import os


configfile: "config/config.yaml"


# Eras of the CMOR tables, with their repositories (config["eras"], config["current"])
configfile: "config/cmor-tables-eras.json"


# Git repositories, through snakemake-storage-plugin-git (patched to support a
# git ref as URL fragment, e.g. https://github.com/PCMDI/cmip6-cmor-tables.git#6.9.33)
storage git:
    provider="git",
    keep_local=True,


# Zenodo records, through snakemake-storage-plugin-zenodo. The plugin requires
# an access token, which Zenodo ignores for published records: a placeholder is
# used if none is given (environment variable SNAKEMAKE_STORAGE_ZENODO_ACCESS_TOKEN)
storage zenodo:
    provider="zenodo",
    keep_local=True,
    access_token=os.environ.get("SNAKEMAKE_STORAGE_ZENODO_ACCESS_TOKEN", "anonymous"),


include: "patches/git_storage_plugin.py"


include: "rules/ontologies.smk"


include: "rules/gwls.smk"


include: "rules/cf_standard_names.smk"


include: "rules/cmor_tables.smk"


include: "rules/cmip5_cvs.smk"


include: "rules/cmip5.smk"


include: "rules/cordex_domains.smk"


include: "rules/cordex_cmip5_cvs.smk"


include: "rules/cordex_cmip5.smk"


include: "rules/ukcp18.smk"


include: "rules/climdex.smk"


include: "rules/mohc_cvs.smk"


# The whole KG: mapped, consolidated, validated (rule validate fails on
# violations), described (with its key figures) and exported
rule build:
    default_target: True
    input:
        "kg/export/kg.nq.gz",
        "kg/export/void.ttl",
        "kg/validation/passed",
        "kg/metadata/figures.json",


# Mappings of the sources to the KG
rule mapping:
    input:
        rules.ontologies.input,
        rules.gwls.input,
        rules.cf_standard_names.input,
        rules.cmor_tables.input,
        rules.cmip5_cvs.input,
        rules.cmip5.input,
        rules.cordex_domains.input,
        rules.cordex_cmip5_cvs.input,
        rules.cordex_cmip5.input,
        rules.ukcp18.input,
        rules.climdex.input,
        rules.mohc_cvs.input,


# Analyses of the sources
rule sources_analysis:
    input:
        rules.cmor_tables_analysis.output,
        rules.ukcp18_unmapped_variables.output,
        rules.ukcp18_variables_check.output,
        rules.cordex_cmip5_variables_check.output,


# Consolidation of the KG (after the mappings)
include: "rules/consolidate.smk"


# Validation of the consolidated KG with its SHACL shapes
include: "rules/validate.smk"


# Metadata of the KG (statistics, provenance, results of the validation)
include: "rules/metadata.smk"


# Release of a version of the KG (Zenodo, GitHub)
include: "rules/release.smk"
